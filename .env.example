# ==========================================
# Viral Clips AI - Environment Configuration
# ==========================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES.
# NEVER COMMIT .env TO VERSION CONTROL.

# Environment
APP_ENV=development
LOG_LEVEL=INFO

# Hardware & Video Engine
# Concurrency: default 1 for RTX 4060 8GB VRAM
GPU_WORKER_CONCURRENCY=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
USE_NVENC=true

# Media Processing Limits (Cost & Security Guardrails)
MAX_SOURCE_DURATION_MINUTES=180
MAX_VIDEO_WIDTH=3840
MAX_VIDEO_HEIGHT=2160
MAX_VIDEO_FPS=60
MAX_FILE_SIZE_BYTES=10737418240  # 10 GB
MAX_CLIPS_PER_RUN=10

# ASR (Transcription)
# Provider: faster-whisper (local GPU) | groq | deepgram
ASR_PROVIDER=faster-whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# LLM Providers (Highlight & Rerank)
# Primary options: gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Storage Adapter: local | r2
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_TEMP_DIR=./temp

# Cloudflare R2 (Production zero-egress storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_PREFIX=

# Database & Queue (Phase 5-6)
DATABASE_URL=sqlite:///./storage/viral_clips.db
REDIS_URL=redis://localhost:6379/0
